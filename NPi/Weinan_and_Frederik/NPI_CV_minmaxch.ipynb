    "df = pd.read_csv(r\"done.csv\")\n",
    "X = df[FEATURES].copy()\n",
    "y_raw = df[TARGET].astype(float).values\n",
    "groups = df[GROUP].values\n",
    "\n",
    "\n",
    "X_trans = X.copy()"
   ]
