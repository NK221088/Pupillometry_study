    "import sympy as sp\n",
    "import numpy as np\n",
    "\n",
    "# raw-unit symbols — the actual variables of interest\n",
    "x_size_raw, x_ch_raw, x_min_raw = sp.symbols('x_size_raw x_ch_raw x_min_raw', real=True)\n",
    "\n",
    "# reference means/stds (fill in your actual values)\n",
    "mu_size, s_size = df_HC[\"pupil_size\"].dropna().mean(), df_HC[\"pupil_size\"].dropna().std()\n",
    "mu_ch,   s_ch   = df_HC[\"ch\"].dropna().mean(), df_HC[\"ch\"].dropna().std()\n",
    "mu_min,  s_min  = df_HC[\"pupil_min\"].dropna().mean(), df_HC[\"pupil_min\"].dropna().std()\n",
    "\n",
    "# z-score transform, symbolic\n",
    "z_size = (x_size_raw - mu_size) / s_size\n",
    "z_ch   = (x_ch_raw   - mu_ch)   / s_ch\n",
    "z_min  = (x_min_raw  - mu_min)  / s_min\n",
    "\n",
    "# your original formula, now composed with the standardization\n",
    "f_raw = (0.2519*z_size**2 \n",
    "         + 0.04208*z_size*sp.exp(-z_size) \n",
    "         + 0.9949*sp.log((0.1173*z_ch + 1.247)**3) \n",
    "         + 3.434*sp.exp(-0.2216*z_min) \n",
    "         - 2.451)\n",
    "\n",
    "# differentiate directly w.r.t. RAW variables — chain rule handled automatically\n",
    "df_dsize_raw = sp.diff(f_raw, x_size_raw)\n",
    "df_dch_raw   = sp.diff(f_raw, x_ch_raw)\n",
    "df_dmin_raw  = sp.diff(f_raw, x_min_raw)\n",
    "\n",
    "df_dsize_fn = sp.lambdify((x_size_raw, x_ch_raw, x_min_raw), df_dsize_raw, 'numpy')\n",
    "df_dch_fn   = sp.lambdify((x_size_raw, x_ch_raw, x_min_raw), df_dch_raw, 'numpy')\n",
    "df_dmin_fn  = sp.lambdify((x_size_raw, x_ch_raw, x_min_raw), df_dmin_raw, 'numpy')\n",
    "\n",
    "sigma_raw = 0.005 / np.sqrt(3)  # rounding uncertainty, raw units, 2-decimal resolution\n",
    "\n",
    "def propagated_error(x_size_vals, x_ch_vals, x_min_vals, sigma=sigma_raw):\n",
    "    d_size = df_dsize_fn(x_size_vals, x_ch_vals, x_min_vals)\n",
    "    d_ch   = df_dch_fn(x_size_vals, x_ch_vals, x_min_vals)\n",
    "    d_min  = df_dmin_fn(x_size_vals, x_ch_vals, x_min_vals)\n",
    "    return np.sqrt((d_size*sigma)**2 + (d_ch*sigma)**2 + (d_min*sigma)**2)\n",
    "\n",
    "# now pull the RAW columns directly — no manual scaling needed\n",
    "sigma_npi = propagated_error(\n",
    "    df['pupil_size'].values,\n",
    "    df['ch'].values,\n",
    "    df['pupil_min'].values\n",
    ")\n",
    "residual_std = residuals.std()\n",
    "\n",
    "print(f\"Mean propagated NPi error: {sigma_npi.mean():.4f}\")\n",
    "print(f\"Range: [{sigma_npi.min():.4f}, {sigma_npi.max():.4f}]\")\n",
    "\n",
    "print(f\"Propagated error (measurement floor): {sigma_npi.mean():.4f}\")\n",
    "print(f\"Empirical residual std (holdout):     {residual_std:.4f}\")\n",
    "\n",
    "if residual_std < sigma_npi.mean():\n",
    "    print(\"⚠️ Residual error is smaller than the measurement-resolution floor — possible overfitting\")"
   ]
