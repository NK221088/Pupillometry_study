    "def pysr_expr(x, a, b, c, d):\n",
    "    return x**2 * (a + b * (x + c)**2) + d\n",
    "\n",
    "def pysr_expr(x, a, b):\n",
    "    return a * x**2 * np.log(x + b)\n",
    "\n",
    "def pysr_expr(x, a, b, c):\n",
    "    return a * x**2 + b * x * np.exp(-x) + c"
