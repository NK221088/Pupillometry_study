      "R²: 0.9852980436291776\n"
     ]
    }
   ],
   "source": [
    "z_corrected = a * z_pred + b\n",
    "\n",
    "npi_pred = np.round(1/(1+np.exp(-z_corrected)) * 5,1)\n",
    "\n",
    "\n",
    "\n",
    "mae = mean_absolute_error(y_true, npi_pred)\n",
    "rmse = np.sqrt(mean_squared_error(y_true, npi_pred))\n",
    "r2 = r2_score(y_true, npi_pred)\n",
    "\n",
    "print(\"MAE:\", mae)\n",
    "print(\"RMSE:\", rmse)\n",
    "print(\"R²:\", r2)"
   ]
