    "# ---------- AIC/BIC helper ----------\n",
    "def aic_bic(y_true, y_pred, n_params):\n",
    "    n = len(y_true)\n",
    "    rss = np.sum((y_true - y_pred) ** 2)\n",
    "    aic = n * np.log(rss / n) + 2 * n_params\n",
    "    bic = n * np.log(rss / n) + n_params * np.log(n)\n",
    "    return aic, bic"
   ]
  },
