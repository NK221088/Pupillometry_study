    "# Replace this with whatever functional form PySR actually returns\n",
    "def ch_pysr_expr(x, a, b, c, d):\n",
    "    return a * x + b * np.sin(c * x) + d\n",
    "\n",
    "def ch_pysr_expr(x, a, b):\n",
    "    return np.log((a*x + b)**3)"
   ]
